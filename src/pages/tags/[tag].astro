---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostList from '../../components/PostList.astro'
import TagFilter from '../../components/TagFilter.astro'
import { countTags, getSortedPosts, tagSlug, type Post } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getSortedPosts()
  return countTags(posts).map(([tag]) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts },
  }))
}

interface Props {
  tag: string
  posts: Post[]
}

const { tag, posts } = Astro.props
const tagged = posts.filter((post) => post.data.tags?.includes(tag))
const heading = `${tagged.length} post${tagged.length === 1 ? '' : 's'} tagged with "${tag}"`
---

<BaseLayout title={tag} description={heading}>
  <div>
    <h1>Posts</h1>
    <TagFilter posts={posts} selected={tag} />
    <p style="margin-top: 1rem;">{heading}</p>
    <PostList posts={tagged} />
  </div>
</BaseLayout>
