---
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Computational Effects, Woven In"
  description="An interactive sketch: toggle cross-cutting effects like retries, transactions, logging and authorization, and watch them wrap an unchanged order-fulfillment function."
  wide
>
  <div class="app">
    <header class="top">
      <h1>Computational effects, woven in</h1>
      <p>
        Toggle cross-cutting effects and watch them wrap the same order
        function. Highlighted lines come from an effect; the rest is the
        business program, unchanged.
      </p>
    </header>

    <div class="grid">
      <aside class="panel controls">
        <div class="panel-head">
          <h2>Effects</h2>
          <span class="actions">
            <button type="button" class="link" id="all">all</button>
            <span aria-hidden="true">/</span>
            <button type="button" class="link" id="clear">none</button>
          </span>
        </div>
        <div id="effects"></div>
      </aside>

      <section class="window main">
        <div class="bar">
          <span class="views" role="tablist">
            <button type="button" class="view" data-view="expanded"
              >placeOrder.js</button
            >
            <button type="button" class="view" data-view="rules"
              >checkout-policy.aspect</button
            >
          </span>
          <span class="delta" id="delta"></span>
        </div>
        <pre class="listing" id="woven" aria-live="polite"></pre>
      </section>

      <aside class="side">
        <section class="window">
          <div class="bar">
            <span>business program</span>
            <span class="meta">unchanged</span>
          </div>
          <pre class="listing small" id="core"></pre>
        </section>

        <section class="panel">
          <div class="panel-head"><h2>Run a request</h2></div>
          <div
            class="scenarios"
            id="scenarios"
            role="radiogroup"
            aria-label="Scenario"
          >
            <label class="chip"
              ><input type="radio" name="scenario" value="transient" checked /> Provider
              blips</label
            >
            <label class="chip"
              ><input type="radio" name="scenario" value="declined" /> Card declined</label
            >
            <label class="chip"
              ><input type="radio" name="scenario" value="db" /> DB drops</label
            >
            <label class="chip"
              ><input type="radio" name="scenario" value="ok" /> All good</label
            >
          </div>
          <ol class="trace" id="trace"></ol>
        </section>
      </aside>
    </div>

    <p class="footnote">
      The layers are illustrative handlers applied in one fixed order; effects
      don't commute in general. Only transient failures are retried, idempotency
      keeps a retried payment from charging twice, and a database rollback can't
      undo a payment that already went to an external provider.
    </p>
  </div>
</BaseLayout>

<style>
  .app {
    /* One hue per effect group, borrowed from Solarized so they read on both
       the cream light-mode code background and the dark one. */
    --fx-control: #dc322f;
    --fx-state: #6c71c4;
    --fx-observe: #268bd2;
    --fx-security: #2aa198;
    --fx-good: #859900;
    --fx-bad: #dc322f;
    --rule: color-mix(in srgb, var(--color-text) 15%, transparent);
    --sans: 'Varela Round', sans-serif;
    --mono: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    --tall: calc(100vh - 2rem);
    font-family: var(--sans);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.5rem;
    margin-bottom: 1rem;
  }

  .top h1 {
    font-size: 1.5rem;
    margin: 0;
  }

  .top p {
    margin: 0;
    flex: 1 1 24rem;
    color: var(--color-text-secondary);
    font-family: 'Lora', serif;
    font-size: 0.85rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr) 22rem;
    gap: 0.9rem;
    align-items: start;
  }

  .controls,
  .side {
    position: sticky;
    top: 1rem;
    max-height: var(--tall);
    overflow: auto;
  }

  .side {
    display: grid;
    gap: 0.9rem;
  }

  .panel {
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 0.7rem;
  }

  .panel-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }

  .app h2 {
    font-size: 0.8rem;
    margin: 0;
    letter-spacing: 0.03em;
  }

  .actions {
    color: var(--color-text-secondary);
  }

  .app button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .app .link {
    color: var(--color-link);
  }

  .app .link:hover {
    text-decoration: underline;
  }

  /* --- effect list --- */
  #effects :global(fieldset) {
    border: 0;
    margin: 0 0 0.6rem;
    padding: 0;
  }

  #effects :global(legend) {
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    color: var(--c);
    padding: 0;
    margin-bottom: 0.15rem;
  }

  #effects :global(.row) {
    display: grid;
    grid-template-columns: 0.9rem 1fr;
    gap: 0.5rem;
    padding: 0.3rem 0.4rem;
    margin: 0 -0.4rem;
    border-radius: 4px;
    border-left: 2px solid transparent;
    cursor: pointer;
  }

  #effects :global(.row:hover) {
    background: color-mix(in srgb, var(--c) 8%, transparent);
  }

  #effects :global(.row:has(input:checked)) {
    background: color-mix(in srgb, var(--c) 12%, transparent);
    border-left-color: var(--c);
  }

  #effects :global(input) {
    accent-color: var(--c);
    margin: 0.15rem 0 0;
  }

  #effects :global(small) {
    display: block;
    color: var(--color-text-secondary);
    font-family: 'Lora', serif;
    font-size: 0.7rem;
    line-height: 1.35;
  }

  /* --- code windows --- */
  .window {
    border: 1px solid var(--rule);
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-code-bg);
    color: var(--color-code-text);
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.35rem 0.8rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--color-text) 4%, var(--color-code-bg));
  }

  .meta {
    opacity: 0.55;
  }

  .delta {
    color: var(--fx-good);
    font-weight: 700;
  }

  .views {
    display: flex;
    gap: 1rem;
  }

  .app .view {
    opacity: 0.55;
    border-bottom: 2px solid transparent;
  }

  .app .view:hover {
    opacity: 0.85;
  }

  .app .view.active {
    opacity: 1;
    border-bottom-color: var(--color-link);
  }

  .listing {
    margin: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    padding: 0.6rem 0;
    font-family: var(--mono);
    font-size: 0.7rem;
    line-height: 1.6;
  }

  .main .listing {
    max-height: calc(var(--tall) - 2rem);
    min-height: 24rem;
  }

  .listing.small {
    font-size: 0.62rem;
  }

  .listing :global(.line) {
    display: block;
    width: max-content;
    min-width: 100%;
    padding: 0 1rem 0 0;
    border-left: 3px solid transparent;
  }

  .listing :global(.ln) {
    display: inline-block;
    width: 2.6em;
    padding-right: 1em;
    text-align: right;
    opacity: 0.4;
    user-select: none;
  }

  .listing :global(.added) {
    border-left-color: var(--c);
    background: color-mix(in srgb, var(--c) 12%, transparent);
  }

  .listing :global(.comment) {
    font-style: italic;
    opacity: 0.65;
  }

  .listing :global(.kw) {
    font-weight: 700;
  }

  /* --- scenarios and trace --- */
  .scenarios {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.1rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.72rem;
    cursor: pointer;
    user-select: none;
  }

  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .chip:hover,
  .chip:has(input:checked) {
    border-color: var(--color-link);
  }

  .chip:has(input:checked) {
    background: color-mix(in srgb, var(--color-link) 14%, transparent);
  }

  .chip:has(input:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }

  .trace {
    list-style: none;
    margin: 0.8rem 0 0 0.35rem;
    padding: 0;
    font-family: 'Lora', serif;
    font-size: 0.76rem;
  }

  .trace :global(li) {
    position: relative;
    margin: 0;
    padding: 0 0 0.3rem 1.1rem;
    border-left: 1px solid
      color-mix(in srgb, var(--color-text-secondary) 50%, transparent);
  }

  .trace :global(li:last-child) {
    border-left-color: transparent;
  }

  .trace :global(li::before) {
    content: '';
    position: absolute;
    left: -0.27rem;
    top: 0.4em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-bg);
    border: 1.5px solid var(--color-text-secondary);
  }

  .trace :global(.good) {
    color: var(--fx-good);
  }

  .trace :global(.bad) {
    color: var(--fx-bad);
  }

  .trace :global(.good::before) {
    border-color: var(--fx-good);
    background: var(--fx-good);
  }

  .trace :global(.bad::before) {
    border-color: var(--fx-bad);
    background: var(--fx-bad);
  }

  .footnote {
    margin: 1rem 0 0;
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.72rem;
    color: var(--color-text-secondary);
  }

  /* Medium screens: the business program and trace move under the code. */
  @media (max-width: 1150px) {
    .grid {
      grid-template-columns: 15rem minmax(0, 1fr);
    }

    .side {
      grid-column: 1 / -1;
      position: static;
      max-height: none;
      grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
      align-items: start;
    }
  }

  /* Phones: one column, nothing sticky. */
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .controls {
      position: static;
      max-height: none;
    }

    .main .listing {
      max-height: 70vh;
      min-height: 0;
    }
  }
</style>

<script>
  type Effect = {
    id: string
    name: string
    group: string
    hue: string
    desc: string
  }

  const groups: Record<string, { label: string; hue: string }> = {
    control: { label: 'Control & reliability', hue: 'var(--fx-control)' },
    state: { label: 'State & resources', hue: 'var(--fx-state)' },
    observe: { label: 'Observation', hue: 'var(--fx-observe)' },
    security: { label: 'Security & consistency', hue: 'var(--fx-security)' },
  }

  const E: Effect[] = (
    [
      [
        'failure',
        'Failure handling',
        'control',
        'Turns failures into an explicit Result. A failed step short-circuits the rest and returns an error.',
      ],
      [
        'retry',
        'Retry with backoff',
        'control',
        'Retries transient remote failures a bounded number of times with exponential backoff. Permanent failures are not retried.',
      ],
      [
        'timeout',
        'Timeouts',
        'control',
        'Puts a deadline on remote calls. A timeout becomes a failure for the other layers to handle.',
      ],
      [
        'transaction',
        'Database transaction',
        'state',
        'Groups database writes into commit-or-rollback. It cannot roll back a payment provider outside the database.',
      ],
      [
        'connection',
        'Connection management',
        'state',
        'Acquires a database connection for the scope, reuses it, and releases it even when the body fails.',
      ],
      [
        'logging',
        'Structured logging',
        'observe',
        'Adds structured start, finish and failure events around operations without changing their results.',
      ],
      [
        'metrics',
        'Metrics',
        'observe',
        'Measures latency and outcome counts for remote and database operations.',
      ],
      [
        'tracing',
        'Distributed tracing',
        'observe',
        'Opens a request span and propagates trace context to downstream calls.',
      ],
      [
        'auth',
        'Authorization',
        'security',
        'Checks permission before any side effects. A denial exits before charging or reserving stock.',
      ],
      [
        'idempotency',
        'Idempotency',
        'security',
        'Deduplicates repeated order submissions by order id, which also makes payment retries safe.',
      ],
    ] as const
  ).map(([id, name, group, desc]) => ({
    id,
    name,
    group,
    desc,
    hue: groups[group].hue,
  }))

  const core = [
    '// Fulfill one validated customer order',
    'function placeOrder(order, customer) {',
    '  const validOrder = validateOrder(order);',
    '  const total = calculateTotal(validOrder);',
    '  const payment = chargePayment(customer, total, order.id);',
    '  reserveStock(validOrder.items);',
    '  const shipment = createShipment(validOrder);',
    '  saveOrder(validOrder, payment, shipment);',
    '  sendConfirmation(customer, shipment);',
    '  return makeReceipt(validOrder, payment, shipment);',
    '}',
  ]

  type Line = [string, string?]

  let on = new Set<string>()
  let view = 'expanded'
  const $ = (id: string) => document.getElementById(id)!
  const has = (id: string) => on.has(id)

  const esc = (s: string) =>
    s.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')

  function paint(el: HTMLElement, lines: Line[]) {
    el.innerHTML = lines
      .map(([s, id], i) => {
        const hue = id ? E.find((e) => e.id === id)!.hue : ''
        const t = esc(s)
          .replace(
            /\b(function|const|return|if|else|try|catch|finally|throw|await|async|new|aspect|around)\b/g,
            '<span class="kw">$1</span>'
          )
          .replace(/(\/\/.*)$/, '<span class="comment">$1</span>')
        return `<span class="line${id ? ' added' : ''}" style="--c:${hue}"><span class="ln">${i + 1}</span>${t}</span>`
      })
      .join('')
  }

  function woven(): Line[] {
    const a: Line[] = []
    const add = (s: string, id?: string) => a.push([s, id])
    if (has('failure')) add('try {', 'failure')
    if (has('tracing'))
      add('  return await withSpan("placeOrder", async (trace) => {', 'tracing')
    if (has('logging'))
      add('  log.info("placeOrder.started", { orderId: order.id });', 'logging')
    if (has('auth')) {
      add('  if (!await authorize(customer, "order:fulfill")) {', 'auth')
      add('    return Err("forbidden");', 'auth')
      add('  }', 'auth')
    }
    if (has('idempotency'))
      add(
        '  return await idempotent(`order:${order.id}`, async () => {',
        'idempotency'
      )
    if (has('connection'))
      add('    return await withConnection(db, async (conn) => {', 'connection')
    if (has('transaction'))
      add(
        '      return await withTransaction(conn, async (tx) => {',
        'transaction'
      )
    const p = ' '.repeat(
      6 + (has('connection') ? 2 : 0) + (has('idempotency') ? 2 : 0)
    )
    add(p + '// The business steps, in the same order')
    add(p + 'const validOrder = validateOrder(order);')
    add(p + 'const total = calculateTotal(validOrder);')
    const operation = (name: string, call: string) => {
      if (has('logging')) add(p + `log.debug("${name}.started");`, 'logging')
      let expr = call
      let outer: string | undefined
      if (has('retry')) {
        expr = `retryTransient({ attempts: 3, backoff: "exponential" }, () => ${expr})`
        outer = 'retry'
      }
      if (has('timeout')) {
        expr = `withTimeout("2s", () => ${expr})`
        outer = 'timeout'
      }
      if (has('metrics')) {
        expr = `measure("${name}", () => ${expr})`
        outer = 'metrics'
      }
      add(p + `const ${name}Result = await ${expr};`, outer)
      if (has('logging')) add(p + `log.debug("${name}.completed");`, 'logging')
    }
    operation('payment', 'chargePayment(customer, total, order.id)')
    operation('inventory', 'reserveStock(validOrder.items)')
    add(p + 'const shipment = createShipment(validOrder);')
    if (has('transaction'))
      add(
        p + 'await tx.saveOrder(validOrder, paymentResult, shipment);',
        'transaction'
      )
    else add(p + 'saveOrder(validOrder, paymentResult, shipment);')
    add(p + 'await sendConfirmation(customer, shipment);')
    add(p + 'return makeReceipt(validOrder, paymentResult, shipment);')
    if (has('transaction')) add('      });', 'transaction')
    if (has('connection')) add('    });', 'connection')
    if (has('idempotency')) add('  });', 'idempotency')
    if (has('tracing')) add('  }); // end request span', 'tracing')
    if (has('logging'))
      add(
        '  log.info("placeOrder.finished", { orderId: order.id });',
        'logging'
      )
    if (has('failure')) {
      add('} catch (error) {', 'failure')
      if (has('logging'))
        add('  log.error("placeOrder.failed", { error });', 'logging')
      add('  return Err(error);', 'failure')
      add('}', 'failure')
    }
    return a
  }

  const ruleText: Record<string, string> = {
    failure: '  on operation(*) when it fails => return Err(error);',
    retry:
      '  around [chargePayment, reserveStock] => retryTransient(3, exponentialBackoff, proceed);',
    timeout: '  around remoteCall(*) => withTimeout(2s, proceed);',
    transaction: '  around databaseWrites(*) => withTransaction(proceed);',
    connection: '  around databaseOperation(*) => withConnection(db, proceed);',
    logging: '  before/after operation(*) => logStructured(event, context);',
    metrics:
      '  around measuredOperation(*) => recordDurationAndOutcome(proceed);',
    tracing:
      '  around placeOrder => withSpan("placeOrder", propagateContext, proceed);',
    auth: '  before placeOrder => requirePermission(customer, "order:fulfill");',
    idempotency: '  around placeOrder => deduplicateBy(order.id, proceed);',
  }

  function rules(): Line[] {
    const a: Line[] = [
      ['// Each rule picks join points and contributes behavior there.'],
      ['aspect CheckoutPolicy {'],
    ]
    E.filter((e) => has(e.id)).forEach((e) => a.push([ruleText[e.id], e.id]))
    a.push(
      ['}'],
      [''],
      ['// The business program stays separate and unchanged.'],
      ['placeOrder(order, customer);']
    )
    return a
  }

  function render() {
    const active = E.filter((e) => has(e.id))
    const lines = view === 'expanded' ? woven() : rules()
    paint($('woven'), lines)
    const added = lines.filter((l) => l[1]).length
    $('delta').textContent = active.length
      ? view === 'expanded'
        ? `+${added} line${added === 1 ? '' : 's'}`
        : `${added} rule${added === 1 ? '' : 's'}`
      : ''
    simulate()
    document.querySelectorAll<HTMLElement>('.view').forEach((b) => {
      const isActive = b.dataset.view === view
      b.classList.toggle('active', isActive)
      b.setAttribute('aria-selected', String(isActive))
    })
  }

  function controls() {
    $('effects').innerHTML = Object.entries(groups)
      .map(
        ([g, { label, hue }]) =>
          `<fieldset style="--c:${hue}"><legend>${label}</legend>` +
          E.filter((e) => e.group === g)
            .map(
              (e) =>
                `<label class="row"><input type="checkbox" id="fx-${e.id}" ${has(e.id) ? 'checked' : ''}><span>${e.name}<small>${e.desc.split('. ')[0].replace(/\.$/, '')}.</small></span></label>`
            )
            .join('') +
          '</fieldset>'
      )
      .join('')
    E.forEach((e) => {
      const box = $('fx-' + e.id) as HTMLInputElement
      box.onchange = () => {
        box.checked ? on.add(e.id) : on.delete(e.id)
        render()
      }
    })
  }

  function simulate() {
    const s = document.querySelector<HTMLInputElement>(
      'input[name="scenario"]:checked'
    )!.value
    const t: string[] = []
    const put = (x: string, c = '') =>
      t.push(`<li class="${c}" style="--i:${t.length}">${x}</li>`)
    if (has('tracing')) put('Open request span')
    if (has('logging')) put('Log: request started')
    if (has('auth')) put('Authorize customer')
    if (s === 'declined') {
      put('Payment: card declined', 'bad')
      if (has('retry')) put('No retry, the failure is permanent', 'bad')
    } else if (s === 'transient') {
      if (has('retry')) {
        put('Payment attempt 1: provider unavailable', 'bad')
        put('Back off 200ms')
        put('Payment attempt 2: success', 'good')
        put('Reserve stock: success', 'good')
      } else put('Payment: provider unavailable', 'bad')
    } else if (s === 'db') {
      put('Payment: success', 'good')
      if (has('connection')) put('Acquire database connection')
      if (has('transaction')) put('Begin transaction')
      put('Reserve stock: connection lost', 'bad')
      if (has('transaction')) put('Roll back transaction', 'bad')
      if (has('connection')) put('Release connection')
    } else {
      put('Payment: success', 'good')
      put('Reserve stock: success', 'good')
      put('Save order: success', 'good')
    }
    if (has('metrics')) put('Record latency and outcome')
    if (has('logging')) put('Log: request finished')
    if (has('tracing')) put('Close span')
    if (s === 'ok' || (s === 'transient' && has('retry')))
      put('Return receipt', 'good')
    else
      put(
        has('failure')
          ? 'Return Err(error)'
          : 'Exception escapes to the caller',
        'bad'
      )
    $('trace').innerHTML = t.join('')
  }

  paint(
    $('core'),
    core.map((s) => [s])
  )
  controls()
  render()
  $('all').onclick = () => {
    on = new Set(E.map((e) => e.id))
    controls()
    render()
  }
  $('clear').onclick = () => {
    on.clear()
    controls()
    render()
  }
  document.querySelectorAll<HTMLElement>('.view').forEach(
    (b) =>
      (b.onclick = () => {
        view = b.dataset.view!
        render()
      })
  )
  $('scenarios').onchange = simulate
</script>
