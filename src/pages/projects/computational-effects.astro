---
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Computational Effects, Woven In"
  description="An interactive sketch: toggle cross-cutting effects like retries, transactions, logging and authorization, and watch them wrap an unchanged order-fulfillment function."
>
  <article class="fx">
    <header class="intro">
      <p class="kicker">An interactive sketch</p>
      <h1>Computational effects, woven in</h1>
      <p class="lede">
        Below is an ordinary order-fulfillment function. Real implementations of
        it rarely stay this small: retries, timeouts, transactions, logging,
        tracing and authorization all get wrapped around it. Each one is a
        cross-cutting effect that changes how the program runs without changing
        what the business wants done. Toggle them to see how much code they add
        around the same few business steps.
      </p>
    </header>

    <section>
      <h2><span class="num">i.</span> The business program</h2>
      <figure class="window">
        <figcaption>
          <span class="file">placeOrder.js</span>
          <span class="meta">stays the same throughout</span>
        </figcaption>
        <pre class="listing" id="core"></pre>
      </figure>
    </section>

    <section>
      <h2><span class="num">ii.</span> Effects</h2>
      <div id="effects" class="groups"></div>
      <p class="buttons">
        <button type="button" class="link" id="all">Enable all</button>
        <span aria-hidden="true">·</span>
        <button type="button" class="link" id="clear">Clear all</button>
      </p>
    </section>

    <section>
      <h2><span class="num">iii.</span> The woven implementation</h2>
      <figure class="window">
        <figcaption>
          <span class="views" role="tablist">
            <button type="button" class="view" data-view="expanded"
              >placeOrder.js</button
            >
            <button type="button" class="view" data-view="rules"
              >checkout-policy.aspect</button
            >
          </span>
          <span class="meta delta" id="delta"></span>
        </figcaption>
        <pre class="listing" id="woven" aria-live="polite"></pre>
      </figure>
      <p class="aside" id="summary"></p>
      <dl id="details"></dl>
      <aside class="note">
        The layers here are illustrative handlers, applied in one fixed order.
        Effects don't commute in general. Retrying inside a transaction is a
        different program from wrapping a retry around one.
      </aside>
    </section>

    <section>
      <h2><span class="num">iv.</span> Running a request</h2>
      <p>
        Pick a scenario to see which steps one request goes through with the
        effects that are currently on.
      </p>
      <div class="chips" id="scenarios" role="radiogroup" aria-label="Scenario">
        <label class="chip"
          ><input type="radio" name="scenario" value="transient" checked /> Payment
          provider blips</label
        >
        <label class="chip"
          ><input type="radio" name="scenario" value="declined" /> Card declined</label
        >
        <label class="chip"
          ><input type="radio" name="scenario" value="db" /> Database drops</label
        >
        <label class="chip"
          ><input type="radio" name="scenario" value="ok" /> All good</label
        >
      </div>
      <ol class="trace" id="trace"></ol>
      <aside class="note">
        Only transient failures are retried, and idempotency keeps a retried
        payment from charging twice. A database rollback can't undo a payment
        that has already gone to an external provider.
      </aside>
    </section>
  </article>
</BaseLayout>

<style>
  .fx {
    /* One hue per effect group, borrowed from Solarized so they read on both
       the cream light-mode code background and the dark one. */
    --fx-control: #dc322f;
    --fx-state: #6c71c4;
    --fx-observe: #268bd2;
    --fx-security: #2aa198;
    --fx-good: #859900;
    --fx-bad: #dc322f;
    --rule: color-mix(in srgb, var(--color-text) 15%, transparent);
    --sans: 'Varela Round', sans-serif;
    --mono: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
  }

  /* --- intro --- */
  .kicker {
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-link);
    margin-bottom: 0.3rem;
  }

  .intro h1 {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .lede {
    font-size: 1.08rem;
    border-left: 3px solid var(--color-link);
    padding-left: 1rem;
  }

  /* --- sections --- */
  .fx section {
    margin-top: 2.6rem;
  }

  .fx h2 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rule);
  }

  .num {
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.9em;
    color: var(--color-link);
    min-width: 1.6em;
  }

  .aside {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }

  .note {
    font-size: 0.82rem;
    font-style: italic;
    color: var(--color-text-secondary);
    margin: 1.2rem 0;
    padding: 0.2rem 0 0.2rem 1rem;
    border-left: 2px solid var(--rule);
  }

  /* --- code windows --- */
  .window {
    margin: 1rem 0;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--color-code-bg);
  }

  .window figcaption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.35rem 0.9rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    text-align: left;
    color: var(--color-code-text);
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--color-text) 4%, var(--color-code-bg));
  }

  .file::before {
    content: '● ● ●';
    letter-spacing: 0.15em;
    margin-right: 0.8rem;
    opacity: 0.3;
  }

  .meta {
    opacity: 0.6;
  }

  .delta {
    opacity: 1;
    color: var(--fx-good);
    font-weight: 700;
  }

  .listing {
    margin: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-code-text);
    padding: 0.8rem 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 1.65;
  }

  .listing :global(.line) {
    display: block;
    width: max-content;
    min-width: 100%;
    padding: 0 1rem 0 0;
    border-left: 3px solid transparent;
  }

  .listing :global(.ln) {
    display: inline-block;
    width: 2.6em;
    padding-right: 1em;
    text-align: right;
    opacity: 0.4;
    user-select: none;
  }

  .listing :global(.added) {
    border-left-color: var(--c);
    background: color-mix(in srgb, var(--c) 12%, transparent);
    animation: fx-in 0.35s ease-out;
  }

  @keyframes fx-in {
    from {
      background: color-mix(in srgb, var(--c) 35%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .listing :global(.added) {
      animation: none;
    }
  }

  .listing :global(.comment) {
    font-style: italic;
    opacity: 0.65;
  }

  .listing :global(.kw) {
    font-weight: 700;
  }

  /* --- effect chips --- */
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 0.4rem 1.5rem;
  }

  .groups :global(fieldset) {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .groups :global(legend) {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--c);
    margin-bottom: 0.4rem;
    padding: 0;
  }

  .groups :global(.chips),
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.8rem;
  }

  .fx :global(.chip) {
    --c: var(--color-link);
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-family: var(--sans);
    font-size: 0.78rem;
    cursor: pointer;
    user-select: none;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .groups :global(.chip) {
    --c: inherit;
  }

  .fx :global(.chip input) {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .fx :global(.chip::before) {
    content: '';
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    border: 1.5px solid var(--c);
    transition: background-color 0.15s ease;
  }

  .fx :global(.chip:hover) {
    border-color: var(--c);
  }

  .fx :global(.chip:has(input:checked)) {
    border-color: var(--c);
    background: color-mix(in srgb, var(--c) 14%, transparent);
  }

  .fx :global(.chip:has(input:checked)::before) {
    background: var(--c);
  }

  .fx :global(.chip:has(input:focus-visible)) {
    outline: 2px solid var(--c);
    outline-offset: 2px;
  }

  /* --- buttons and view tabs --- */
  .buttons {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .fx button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .fx .link {
    color: var(--color-link);
  }

  .fx .link:hover {
    color: var(--color-link-hover);
    text-decoration: underline;
  }

  .views {
    display: flex;
    gap: 1rem;
  }

  .fx .view {
    font-family: var(--mono);
    opacity: 0.55;
    padding-bottom: 0.1rem;
    border-bottom: 2px solid transparent;
  }

  .fx .view:hover {
    opacity: 0.85;
  }

  .fx .view.active {
    opacity: 1;
    border-bottom-color: var(--color-link);
  }

  /* --- active effect notes --- */
  #details {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 0.6rem 1.5rem;
    font-size: 0.82rem;
  }

  #details :global(div) {
    border-left: 2px solid var(--c);
    padding-left: 0.7rem;
  }

  #details :global(dt) {
    font-family: var(--sans);
    color: var(--c);
  }

  #details :global(dd) {
    margin: 0;
    color: var(--color-text-secondary);
  }

  /* --- trace timeline --- */
  .trace {
    list-style: none;
    margin: 1.2rem 0 0 0.4rem;
    padding: 0;
    font-size: 0.85rem;
    counter-reset: step;
  }

  .trace :global(li) {
    position: relative;
    margin: 0;
    padding: 0 0 0.45rem 1.4rem;
    border-left: 1px solid
      color-mix(in srgb, var(--color-text-secondary) 50%, transparent);
    counter-increment: step;
    animation: fx-step 0.3s ease-out backwards;
    animation-delay: calc(var(--i) * 40ms);
  }

  .trace :global(li:last-child) {
    border-left-color: transparent;
  }

  .trace :global(li::before) {
    content: '';
    position: absolute;
    left: -0.3rem;
    top: 0.45em;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-bg);
    border: 1.5px solid var(--color-text-secondary);
  }

  .trace :global(.good) {
    color: var(--fx-good);
  }

  .trace :global(.good::before) {
    border-color: var(--fx-good);
    background: var(--fx-good);
  }

  .trace :global(.bad) {
    color: var(--fx-bad);
  }

  .trace :global(.bad::before) {
    border-color: var(--fx-bad);
    background: var(--fx-bad);
  }

  @keyframes fx-step {
    from {
      opacity: 0;
      transform: translateX(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trace :global(li) {
      animation: none;
    }
  }
</style>

<script>
  type Effect = {
    id: string
    name: string
    group: string
    hue: string
    desc: string
  }

  const groups: Record<string, { label: string; hue: string }> = {
    control: { label: 'Control & reliability', hue: 'var(--fx-control)' },
    state: { label: 'State & resources', hue: 'var(--fx-state)' },
    observe: { label: 'Observation', hue: 'var(--fx-observe)' },
    security: { label: 'Security & consistency', hue: 'var(--fx-security)' },
  }

  const E: Effect[] = (
    [
      [
        'failure',
        'Failure handling',
        'control',
        'Turns failures into an explicit Result. A failed step short-circuits the rest and returns an error.',
      ],
      [
        'retry',
        'Retry with backoff',
        'control',
        'Retries transient remote failures a bounded number of times with exponential backoff. Permanent failures are not retried.',
      ],
      [
        'timeout',
        'Timeouts',
        'control',
        'Puts a deadline on remote calls. A timeout becomes a failure for the other layers to handle.',
      ],
      [
        'transaction',
        'Database transaction',
        'state',
        'Groups database writes into commit-or-rollback. It cannot roll back a payment provider outside the database.',
      ],
      [
        'connection',
        'Connection management',
        'state',
        'Acquires a database connection for the scope, reuses it, and releases it even when the body fails.',
      ],
      [
        'logging',
        'Structured logging',
        'observe',
        'Adds structured start, finish and failure events around operations without changing their results.',
      ],
      [
        'metrics',
        'Metrics',
        'observe',
        'Measures latency and outcome counts for remote and database operations.',
      ],
      [
        'tracing',
        'Distributed tracing',
        'observe',
        'Opens a request span and propagates trace context to downstream calls.',
      ],
      [
        'auth',
        'Authorization',
        'security',
        'Checks permission before any side effects. A denial exits before charging or reserving stock.',
      ],
      [
        'idempotency',
        'Idempotency',
        'security',
        'Deduplicates repeated order submissions by order id, which also makes payment retries safe.',
      ],
    ] as const
  ).map(([id, name, group, desc]) => ({
    id,
    name,
    group,
    desc,
    hue: groups[group].hue,
  }))

  const core = [
    '// Fulfill one validated customer order',
    'function placeOrder(order, customer) {',
    '  const validOrder = validateOrder(order);',
    '  const total = calculateTotal(validOrder);',
    '  const payment = chargePayment(customer, total, order.id);',
    '  reserveStock(validOrder.items);',
    '  const shipment = createShipment(validOrder);',
    '  saveOrder(validOrder, payment, shipment);',
    '  sendConfirmation(customer, shipment);',
    '  return makeReceipt(validOrder, payment, shipment);',
    '}',
  ]

  type Line = [string, string?]

  let on = new Set<string>()
  let view = 'expanded'
  const $ = (id: string) => document.getElementById(id)!
  const has = (id: string) => on.has(id)

  const esc = (s: string) =>
    s.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')

  function paint(el: HTMLElement, lines: Line[]) {
    el.innerHTML = lines
      .map(([s, id], i) => {
        const hue = id ? E.find((e) => e.id === id)!.hue : ''
        const t = esc(s)
          .replace(
            /\b(function|const|return|if|else|try|catch|finally|throw|await|async|new|aspect|around)\b/g,
            '<span class="kw">$1</span>'
          )
          .replace(/(\/\/.*)$/, '<span class="comment">$1</span>')
        return `<span class="line${id ? ' added' : ''}" style="--c:${hue}"><span class="ln">${i + 1}</span>${t}</span>`
      })
      .join('')
  }

  function woven(): Line[] {
    const a: Line[] = []
    const add = (s: string, id?: string) => a.push([s, id])
    if (has('failure')) add('try {', 'failure')
    if (has('tracing'))
      add('  return await withSpan("placeOrder", async (trace) => {', 'tracing')
    if (has('logging'))
      add('  log.info("placeOrder.started", { orderId: order.id });', 'logging')
    if (has('auth')) {
      add('  if (!await authorize(customer, "order:fulfill")) {', 'auth')
      add('    return Err("forbidden");', 'auth')
      add('  }', 'auth')
    }
    if (has('idempotency'))
      add(
        '  return await idempotent(`order:${order.id}`, async () => {',
        'idempotency'
      )
    if (has('connection'))
      add('    return await withConnection(db, async (conn) => {', 'connection')
    if (has('transaction'))
      add(
        '      return await withTransaction(conn, async (tx) => {',
        'transaction'
      )
    const p = ' '.repeat(
      6 + (has('connection') ? 2 : 0) + (has('idempotency') ? 2 : 0)
    )
    add(p + '// The business steps, in the same order')
    add(p + 'const validOrder = validateOrder(order);')
    add(p + 'const total = calculateTotal(validOrder);')
    const operation = (name: string, call: string) => {
      if (has('logging')) add(p + `log.debug("${name}.started");`, 'logging')
      let expr = call
      let outer: string | undefined
      if (has('retry')) {
        expr = `retryTransient({ attempts: 3, backoff: "exponential" }, () => ${expr})`
        outer = 'retry'
      }
      if (has('timeout')) {
        expr = `withTimeout("2s", () => ${expr})`
        outer = 'timeout'
      }
      if (has('metrics')) {
        expr = `measure("${name}", () => ${expr})`
        outer = 'metrics'
      }
      add(p + `const ${name}Result = await ${expr};`, outer)
      if (has('logging')) add(p + `log.debug("${name}.completed");`, 'logging')
    }
    operation('payment', 'chargePayment(customer, total, order.id)')
    operation('inventory', 'reserveStock(validOrder.items)')
    add(p + 'const shipment = createShipment(validOrder);')
    if (has('transaction'))
      add(
        p + 'await tx.saveOrder(validOrder, paymentResult, shipment);',
        'transaction'
      )
    else add(p + 'saveOrder(validOrder, paymentResult, shipment);')
    add(p + 'await sendConfirmation(customer, shipment);')
    add(p + 'return makeReceipt(validOrder, paymentResult, shipment);')
    if (has('transaction')) add('      });', 'transaction')
    if (has('connection')) add('    });', 'connection')
    if (has('idempotency')) add('  });', 'idempotency')
    if (has('tracing')) add('  }); // end request span', 'tracing')
    if (has('logging'))
      add(
        '  log.info("placeOrder.finished", { orderId: order.id });',
        'logging'
      )
    if (has('failure')) {
      add('} catch (error) {', 'failure')
      if (has('logging'))
        add('  log.error("placeOrder.failed", { error });', 'logging')
      add('  return Err(error);', 'failure')
      add('}', 'failure')
    }
    return a
  }

  const ruleText: Record<string, string> = {
    failure: '  on operation(*) when it fails => return Err(error);',
    retry:
      '  around [chargePayment, reserveStock] => retryTransient(3, exponentialBackoff, proceed);',
    timeout: '  around remoteCall(*) => withTimeout(2s, proceed);',
    transaction: '  around databaseWrites(*) => withTransaction(proceed);',
    connection: '  around databaseOperation(*) => withConnection(db, proceed);',
    logging: '  before/after operation(*) => logStructured(event, context);',
    metrics:
      '  around measuredOperation(*) => recordDurationAndOutcome(proceed);',
    tracing:
      '  around placeOrder => withSpan("placeOrder", propagateContext, proceed);',
    auth: '  before placeOrder => requirePermission(customer, "order:fulfill");',
    idempotency: '  around placeOrder => deduplicateBy(order.id, proceed);',
  }

  function rules(): Line[] {
    const a: Line[] = [
      ['// Each rule picks join points and contributes behavior there.'],
      ['aspect CheckoutPolicy {'],
    ]
    E.filter((e) => has(e.id)).forEach((e) => a.push([ruleText[e.id], e.id]))
    a.push(
      ['}'],
      [''],
      ['// The business program stays separate and unchanged.'],
      ['placeOrder(order, customer);']
    )
    return a
  }

  function render() {
    const active = E.filter((e) => has(e.id))
    const lines = view === 'expanded' ? woven() : rules()
    paint($('woven'), lines)
    const added = lines.filter((l) => l[1]).length
    $('summary').textContent = active.length
      ? `${active.length} effect${active.length === 1 ? '' : 's'} on, contributing the ${added} highlighted line${added === 1 ? '' : 's'}. Unhighlighted lines are the business program.`
      : 'No effects on yet, so this is just the business program.'
    $('delta').textContent = active.length
      ? view === 'expanded'
        ? `+${added} line${added === 1 ? '' : 's'}`
        : `${added} rule${added === 1 ? '' : 's'}`
      : ''
    $('details').innerHTML = active
      .map(
        (e) =>
          `<div style="--c:${e.hue}"><dt>${e.name}</dt><dd>${e.desc}</dd></div>`
      )
      .join('')
    simulate()
    document.querySelectorAll<HTMLElement>('.view').forEach((b) => {
      const isActive = b.dataset.view === view
      b.classList.toggle('active', isActive)
      b.setAttribute('aria-selected', String(isActive))
    })
  }

  function controls() {
    $('effects').innerHTML = Object.entries(groups)
      .map(
        ([g, { label, hue }]) =>
          `<fieldset style="--c:${hue}"><legend>${label}</legend><div class="chips">` +
          E.filter((e) => e.group === g)
            .map(
              (e) =>
                `<label class="chip" title="${e.desc}"><input type="checkbox" id="fx-${e.id}" ${has(e.id) ? 'checked' : ''}> ${e.name}</label>`
            )
            .join('') +
          '</div></fieldset>'
      )
      .join('')
    E.forEach((e) => {
      const box = $('fx-' + e.id) as HTMLInputElement
      box.onchange = () => {
        box.checked ? on.add(e.id) : on.delete(e.id)
        render()
      }
    })
  }

  function simulate() {
    const s = document.querySelector<HTMLInputElement>(
      'input[name="scenario"]:checked'
    )!.value
    const t: string[] = []
    const put = (x: string, c = '') =>
      t.push(`<li class="${c}" style="--i:${t.length}">${x}</li>`)
    if (has('tracing')) put('Open request span')
    if (has('logging')) put('Log: request started')
    if (has('auth')) put('Authorize customer')
    if (s === 'declined') {
      put('Payment: card declined', 'bad')
      if (has('retry')) put('No retry, the failure is permanent', 'bad')
    } else if (s === 'transient') {
      if (has('retry')) {
        put('Payment attempt 1: provider unavailable', 'bad')
        put('Back off 200ms')
        put('Payment attempt 2: success', 'good')
        put('Reserve stock: success', 'good')
      } else put('Payment: provider unavailable', 'bad')
    } else if (s === 'db') {
      put('Payment: success', 'good')
      if (has('connection')) put('Acquire database connection')
      if (has('transaction')) put('Begin transaction')
      put('Reserve stock: connection lost', 'bad')
      if (has('transaction')) put('Roll back transaction', 'bad')
      if (has('connection')) put('Release connection')
    } else {
      put('Payment: success', 'good')
      put('Reserve stock: success', 'good')
      put('Save order: success', 'good')
    }
    if (has('metrics')) put('Record latency and outcome')
    if (has('logging')) put('Log: request finished')
    if (has('tracing')) put('Close span')
    if (s === 'ok' || (s === 'transient' && has('retry')))
      put('Return receipt', 'good')
    else
      put(
        has('failure')
          ? 'Return Err(error)'
          : 'Exception escapes to the caller',
        'bad'
      )
    $('trace').innerHTML = t.join('')
  }

  paint(
    $('core'),
    core.map((s) => [s])
  )
  controls()
  render()
  $('all').onclick = () => {
    on = new Set(E.map((e) => e.id))
    controls()
    render()
  }
  $('clear').onclick = () => {
    on.clear()
    controls()
    render()
  }
  document.querySelectorAll<HTMLElement>('.view').forEach(
    (b) =>
      (b.onclick = () => {
        view = b.dataset.view!
        render()
      })
  )
  $('scenarios').onchange = simulate
</script>
