---
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Computational Effects, Woven In"
  description="An interactive sketch: toggle cross-cutting effects like retries, transactions, logging and authorization, and watch them wrap an unchanged order-fulfillment function."
  wide
>
  <div class="app">
    <header class="intro">
      <h1>Computational effects, woven in</h1>
      <p>
        An ordinary order-fulfillment function, and the cross-cutting behavior
        that tends to grow around it. Turn effects on and watch the
        implementation change while the business steps stay the same.
      </p>
    </header>

    <div class="layout">
      <aside class="panel sidebar">
        <div class="head">
          <h2>Effects</h2>
          <span class="count" id="count">0 enabled</span>
        </div>
        <div id="effects"></div>
        <div class="actions">
          <button class="btn" id="all">Enable all</button>
          <button class="btn" id="clear">Clear all</button>
        </div>
        <p class="note">
          Highlighted code is introduced by a selected effect. The layers are
          applied in one fixed order; effects don't commute in general.
        </p>
      </aside>

      <section class="content">
        <div class="panel card">
          <div class="head">
            <div>
              <h2>1. Business program</h2>
              <div class="sub">What the business wants done.</div>
            </div>
          </div>
          <div class="code" id="core"></div>
        </div>

        <div class="panel card">
          <div class="head">
            <div>
              <h2>2. Woven implementation</h2>
              <div class="sub" id="caption"></div>
            </div>
            <div class="tabs">
              <button class="tab active" data-view="expanded">Expanded</button>
              <button class="tab" data-view="rules">Aspect rules</button>
            </div>
          </div>
          <div class="code" id="woven" aria-live="polite"></div>
          <div class="note" id="explain"></div>
        </div>

        <div class="panel card">
          <div class="head">
            <div>
              <h2>3. What the effects add</h2>
            </div>
          </div>
          <div class="details" id="details"></div>
        </div>

        <div class="panel card">
          <div class="head">
            <div>
              <h2>4. Explore a failure</h2>
              <div class="sub">
                The steps one request goes through with the current effects.
              </div>
            </div>
          </div>
          <div class="simrow">
            <label for="scenario">Scenario</label>
            <select id="scenario">
              <option value="transient"
                >Temporary payment-provider outage</option
              >
              <option value="declined">Card declined (permanent)</option>
              <option value="db">Database connection drops</option>
              <option value="ok">Everything succeeds</option>
            </select>
          </div>
          <div class="trace" id="trace"></div>
          <p class="note">
            Retry is limited to transient failures; idempotency prevents a
            retried payment request from charging twice. A database rollback
            cannot undo an external payment.
          </p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* Light-mode palette. Effect hues (--c) are set per effect in the script
     and are tuned for dark backgrounds, so in light mode text drawn in an
     effect's hue is darkened via --ink. */
  .app {
    --line: color-mix(in srgb, var(--color-text) 16%, transparent);
    --panel: color-mix(in srgb, var(--color-text) 3%, var(--color-bg));
    --inset: color-mix(in srgb, var(--color-text) 6%, var(--color-bg));
    --muted: var(--color-text-secondary);
    --code-bg: #f7f7f9;
    --code-text: #3b4252;
    --ln: #a0a8b8;
    --syn-comment: #7a8599;
    --syn-kw: #7c4dcc;
    --syn-fn: #2c66c4;
    --syn-str: #2f7d3b;
    --good: #2f7d5c;
    --bad: #b93b4a;
    --ink-mix: 58%;
    --mono: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-family: 'Varela Round', sans-serif;
    font-size: 0.78rem;
    line-height: 1.5;
  }

  :global([data-theme='dark']) .app {
    --code-bg: #12121f;
    --code-text: #d7deea;
    --ln: #526580;
    --syn-comment: #7489a8;
    --syn-kw: #c5a5ff;
    --syn-fn: #8bb8ff;
    --syn-str: #a6d6a9;
    --good: #a4e6c9;
    --bad: #ffaaaa;
    --ink-mix: 100%;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .app {
      --code-bg: #12121f;
      --code-text: #d7deea;
      --ln: #526580;
      --syn-comment: #7489a8;
      --syn-kw: #c5a5ff;
      --syn-fn: #8bb8ff;
      --syn-str: #a6d6a9;
      --good: #a4e6c9;
      --bad: #ffaaaa;
      --ink-mix: 100%;
    }
  }

  .app :global([style*='--c']) {
    --ink: color-mix(in oklab, var(--c) var(--ink-mix), #000);
  }

  .intro h1 {
    margin: 0 0 0.4rem;
  }

  .intro p {
    color: var(--muted);
    font-family: 'Lora', serif;
    font-size: 0.95rem;
    max-width: 50rem;
    margin-bottom: 1.2rem;
  }

  .layout {
    display: grid;
    grid-template-columns: 17rem minmax(0, 1fr);
    gap: 1rem;
  }

  .panel {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
  }

  .sidebar {
    padding: 1rem;
    align-self: start;
    position: sticky;
    top: 1rem;
  }

  .content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
    min-width: 0;
  }

  .card {
    padding: 1rem;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .app h2 {
    font-size: 0.85rem;
    margin: 0;
  }

  .sub {
    font-size: 0.72rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }

  .count {
    font-size: 0.65rem;
    color: var(--muted);
  }

  #effects :global(.group) {
    font-size: 0.68rem;
    color: var(--muted);
    margin: 1rem 0 0.35rem;
  }

  #effects :global(.effect) {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 0.55rem;
    padding: 0.5rem;
    border-radius: 8px;
    border: 1px solid transparent;
  }

  #effects :global(.effect:hover) {
    background: var(--inset);
    border-color: var(--line);
  }

  #effects :global(input) {
    appearance: none;
    width: 16px;
    height: 16px;
    border: 1.5px solid var(--muted);
    border-radius: 4px;
    margin: 2px 0 0;
    cursor: pointer;
    position: relative;
  }

  #effects :global(input:checked) {
    background: var(--c);
    border-color: var(--c);
  }

  #effects :global(input:checked::after) {
    content: '✓';
    position: absolute;
    inset: -2px 0;
    text-align: center;
    color: #08111f;
    font-weight: 900;
    font-size: 12px;
  }

  #effects :global(input:focus-visible) {
    outline: 2px solid var(--c);
    outline-offset: 2px;
  }

  #effects :global(label) {
    cursor: pointer;
  }

  #effects :global(small) {
    display: block;
    color: var(--muted);
    font-family: 'Lora', serif;
    font-size: 0.68rem;
  }

  .actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  .app button,
  .app select {
    font: inherit;
    font-size: 0.72rem;
    color: var(--color-text);
    cursor: pointer;
  }

  .btn {
    border: 1px solid var(--line);
    background: var(--inset);
    border-radius: 7px;
    padding: 0.3rem 0.65rem;
  }

  .btn:hover {
    border-color: var(--muted);
  }

  .tabs {
    display: flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .tab {
    border: 0;
    background: transparent;
    border-radius: 6px;
    padding: 0.25rem 0.6rem;
    color: var(--muted) !important;
  }

  .tab.active {
    background: var(--inset);
    color: var(--color-text) !important;
  }

  .code {
    overflow: auto;
    background: var(--code-bg);
    color: var(--code-text);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.7rem 0;
    font: 0.68rem/1.8 var(--mono);
  }

  .code :global(.line) {
    display: grid;
    grid-template-columns: 38px minmax(max-content, 1fr);
    padding-right: 15px;
    border-left: 2px solid transparent;
  }

  .code :global(.ln) {
    color: var(--ln);
    text-align: right;
    padding-right: 12px;
    user-select: none;
  }

  .code :global(.src) {
    white-space: pre;
  }

  .code :global(.added) {
    background: color-mix(in srgb, var(--c) 14%, transparent);
    border-left-color: var(--c);
  }

  .code :global(.added .src) {
    color: var(--ink);
  }

  .code :global(.comment) {
    color: var(--syn-comment);
    font-style: italic;
  }

  .code :global(.kw) {
    color: var(--syn-kw);
  }

  .code :global(.fn) {
    color: var(--syn-fn);
  }

  .code :global(.str) {
    color: var(--syn-str);
  }

  .note {
    font-size: 0.68rem;
    color: var(--muted);
    margin: 0.6rem 0 0;
  }

  .details {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  .details :global(.detail) {
    background: var(--inset);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.6rem;
  }

  .details :global(b) {
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--ink);
  }

  .details :global(p) {
    font-family: 'Lora', serif;
    font-size: 0.7rem;
    color: var(--muted);
    margin: 0.2rem 0 0;
  }

  .simrow {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .simrow select {
    background: var(--inset);
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 0.3rem 0.4rem;
  }

  .trace {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .trace :global(span) {
    font: 0.68rem var(--mono);
    padding: 0.35rem 0.5rem;
    background: var(--inset);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .trace :global(.bad) {
    color: var(--bad);
    border-color: color-mix(in srgb, var(--bad) 55%, transparent);
  }

  .trace :global(.good) {
    color: var(--good);
    border-color: color-mix(in srgb, var(--good) 55%, transparent);
  }

  @media (max-width: 850px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .sidebar {
      position: static;
    }
  }

  @media (max-width: 520px) {
    .details {
      grid-template-columns: 1fr;
    }

    .head {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

<script>
  type Effect = {
    id: string
    name: string
    group: string
    c: string
    desc: string
  }

  const E: Effect[] = [
    {
      id: 'failure',
      name: 'Failure handling',
      group: 'Control & reliability',
      c: '#ff9292',
      desc: 'Turns failures into an explicit Result path. A failed step short-circuits the happy path and returns an error.',
    },
    {
      id: 'retry',
      name: 'Retry + backoff',
      group: 'Control & reliability',
      c: '#83d6b0',
      desc: 'Retries transient remote failures a bounded number of times, with exponential backoff. Permanent failures are not retried.',
    },
    {
      id: 'timeout',
      name: 'Timeouts',
      group: 'Control & reliability',
      c: '#f1c27b',
      desc: 'Places a deadline around remote calls. A timeout becomes a failure that other layers can handle.',
    },
    {
      id: 'transaction',
      name: 'Database transaction',
      group: 'State & resources',
      c: '#c5a5ff',
      desc: 'Groups database writes into commit-or-rollback behavior. It cannot roll back a payment provider outside the database.',
    },
    {
      id: 'connection',
      name: 'Connection management',
      group: 'State & resources',
      c: '#7dd8e8',
      desc: 'Acquires a database connection for the scope, reuses it, and releases it even when the body fails.',
    },
    {
      id: 'logging',
      name: 'Structured logging',
      group: 'Observation',
      c: '#8bb8ff',
      desc: 'Adds structured entry, completion, and failure events around operations without changing their intended result.',
    },
    {
      id: 'metrics',
      name: 'Metrics',
      group: 'Observation',
      c: '#f2a6d5',
      desc: 'Measures latency and outcome counts for remote and database operations.',
    },
    {
      id: 'tracing',
      name: 'Distributed tracing',
      group: 'Observation',
      c: '#e6b879',
      desc: 'Creates a request span and propagates trace context to downstream calls.',
    },
    {
      id: 'auth',
      name: 'Authorization',
      group: 'Security & consistency',
      c: '#e7a0a0',
      desc: 'Checks permission before side effects begin. Denial exits before charging or reserving stock.',
    },
    {
      id: 'idempotency',
      name: 'Idempotency',
      group: 'Security & consistency',
      c: '#b8c5ff',
      desc: 'Deduplicates repeated order submissions using a stable order key and protects payment retries.',
    },
  ]

  const core = [
    '// Business intent: fulfill one validated customer order',
    'function placeOrder(order, customer) {',
    '  const validOrder = validateOrder(order);',
    '  const total = calculateTotal(validOrder);',
    '  const payment = chargePayment(customer, total, order.id);',
    '  reserveStock(validOrder.items);',
    '  const shipment = createShipment(validOrder);',
    '  saveOrder(validOrder, payment, shipment);',
    '  sendConfirmation(customer, shipment);',
    '  return makeReceipt(validOrder, payment, shipment);',
    '}',
  ]

  type Line = [string, string?]

  let on = new Set<string>()
  let view = 'expanded'
  const $ = (id: string) => document.getElementById(id)!
  const has = (id: string) => on.has(id)

  const esc = (s: string) =>
    s.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')

  const KW = new Set([
    'function',
    'const',
    'return',
    'if',
    'else',
    'try',
    'catch',
    'finally',
    'throw',
    'await',
    'async',
    'new',
    'aspect',
    'around',
    'before',
    'after',
    'on',
    'when',
  ])
  const FN = new Set([
    'log',
    'authorize',
    'withTransaction',
    'withConnection',
    'retryTransient',
    'withTimeout',
    'measure',
    'withSpan',
    'idempotent',
    'chargePayment',
    'reserveStock',
    'saveOrder',
    'createShipment',
    'sendConfirmation',
    'validateOrder',
    'calculateTotal',
    'makeReceipt',
    'placeOrder',
    'Err',
  ])

  // Tokenize so that strings, comments and identifiers are coloured without
  // one pass matching inside another's markup.
  function highlight(s: string) {
    return s.replace(
      /(\/\/.*$)|("[^"]*"|`[^`]*`)|([A-Za-z_]\w*)|([^A-Za-z_"`/]+|\/)/g,
      (_m, comment, str, word, other) => {
        if (comment) return `<i class="comment">${esc(comment)}</i>`
        if (str) return `<span class="str">${esc(str)}</span>`
        if (word)
          return KW.has(word)
            ? `<span class="kw">${word}</span>`
            : FN.has(word)
              ? `<span class="fn">${word}</span>`
              : word
        return esc(other)
      }
    )
  }

  function paint(el: HTMLElement, lines: Line[]) {
    el.innerHTML = lines
      .map(([s, id], i) => {
        const c = id ? E.find((x) => x.id === id)!.c : ''
        return `<div class="line ${id ? 'added' : ''}" style="--c:${c}"><span class="ln">${i + 1}</span><span class="src">${highlight(s)}</span></div>`
      })
      .join('')
  }

  function woven(): Line[] {
    const a: Line[] = []
    const add = (s: string, id?: string) => a.push([s, id])
    if (has('failure')) add('try {', 'failure')
    if (has('tracing'))
      add('  return await withSpan("placeOrder", async (trace) => {', 'tracing')
    if (has('logging'))
      add('  log.info("placeOrder.started", { orderId: order.id });', 'logging')
    if (has('auth')) {
      add('  if (!await authorize(customer, "order:fulfill")) {', 'auth')
      add('    return Err("forbidden");', 'auth')
      add('  }', 'auth')
    }
    if (has('idempotency'))
      add(
        '  return await idempotent(`order:${order.id}`, async () => {',
        'idempotency'
      )
    if (has('connection'))
      add('    return await withConnection(db, async (conn) => {', 'connection')
    if (has('transaction'))
      add(
        '      return await withTransaction(conn, async (tx) => {',
        'transaction'
      )
    const p = ' '.repeat(
      6 + (has('connection') ? 2 : 0) + (has('idempotency') ? 2 : 0)
    )
    add(p + '// Core business steps — same order and intent')
    add(p + 'const validOrder = validateOrder(order);')
    add(p + 'const total = calculateTotal(validOrder);')
    const operation = (name: string, call: string) => {
      if (has('logging')) add(p + `log.debug("${name}.started");`, 'logging')
      let expr = call
      let outer: string | undefined
      if (has('retry')) {
        expr = `retryTransient({ attempts: 3, backoff: "exponential" }, () => ${expr})`
        outer = 'retry'
      }
      if (has('timeout')) {
        expr = `withTimeout("2s", () => ${expr})`
        outer = 'timeout'
      }
      if (has('metrics')) {
        expr = `measure("${name}", () => ${expr})`
        outer = 'metrics'
      }
      add(p + `const ${name}Result = await ${expr};`, outer)
      if (has('logging')) add(p + `log.debug("${name}.completed");`, 'logging')
    }
    operation('payment', 'chargePayment(customer, total, order.id)')
    operation('inventory', 'reserveStock(validOrder.items)')
    add(p + 'const shipment = createShipment(validOrder);')
    if (has('transaction'))
      add(
        p + 'await tx.saveOrder(validOrder, paymentResult, shipment);',
        'transaction'
      )
    else add(p + 'saveOrder(validOrder, paymentResult, shipment);')
    add(p + 'await sendConfirmation(customer, shipment);')
    add(p + 'return makeReceipt(validOrder, paymentResult, shipment);')
    if (has('transaction')) add('      });', 'transaction')
    if (has('connection')) add('    });', 'connection')
    if (has('idempotency')) add('  });', 'idempotency')
    if (has('tracing')) add('  }); // end request span', 'tracing')
    if (has('logging'))
      add(
        '  log.info("placeOrder.finished", { orderId: order.id });',
        'logging'
      )
    if (has('failure')) {
      add('} catch (error) {', 'failure')
      if (has('logging'))
        add('  log.error("placeOrder.failed", { error });', 'logging')
      add('  return Err(error);', 'failure')
      add('}', 'failure')
    }
    return a
  }

  const ruleText: Record<string, string> = {
    failure: '  on operation(*) when it fails => return Err(error);',
    retry:
      '  around [chargePayment, reserveStock] => retryTransient(3, exponentialBackoff, proceed);',
    timeout: '  around remoteCall(*) => withTimeout(2s, proceed);',
    transaction: '  around databaseWrites(*) => withTransaction(proceed);',
    connection: '  around databaseOperation(*) => withConnection(db, proceed);',
    logging: '  before/after operation(*) => logStructured(event, context);',
    metrics:
      '  around measuredOperation(*) => recordDurationAndOutcome(proceed);',
    tracing:
      '  around placeOrder => withSpan("placeOrder", propagateContext, proceed);',
    auth: '  before placeOrder => requirePermission(customer, "order:fulfill");',
    idempotency: '  around placeOrder => deduplicateBy(order.id, proceed);',
  }

  function rules(): Line[] {
    const a: Line[] = [
      ['// Aspect rules select join points and contribute behavior.'],
      ['aspect CheckoutPolicy {'],
    ]
    E.filter((e) => has(e.id)).forEach((e) => a.push([ruleText[e.id], e.id]))
    a.push(
      ['}'],
      ['// The core program remains separate and unchanged.'],
      ['placeOrder(order, customer);']
    )
    return a
  }

  function render() {
    const active = E.filter((e) => has(e.id))
    const lines = view === 'expanded' ? woven() : rules()
    paint($('woven'), lines)
    const added = lines.filter((l) => l[1]).length
    $('count').textContent = active.length + ' enabled'
    $('details').innerHTML =
      active
        .map(
          (e) =>
            `<div class="detail" style="--c:${e.c}"><b>${e.name}</b><p>${e.desc}</p></div>`
        )
        .join('') ||
      '<div class="detail" style="grid-column:1/-1"><b>Nothing woven in yet</b><p>Enable an effect to see where it applies and what behavior it contributes.</p></div>'
    $('caption').textContent =
      view === 'expanded'
        ? 'The selected behavior woven around the business computation.'
        : 'Declarative aspect rules and their join points.'
    $('explain').textContent = active.length
      ? `${active.length} effect${active.length === 1 ? '' : 's'} active, adding ${added} highlighted line${added === 1 ? '' : 's'}. Plain lines are the business computation.`
      : 'Enable effects to see behavior woven around selected operations.'
    document
      .querySelectorAll<HTMLElement>('.tab')
      .forEach((b) => b.classList.toggle('active', b.dataset.view === view))
    simulate()
  }

  function controls() {
    const groups = [...new Set(E.map((e) => e.group))]
    $('effects').innerHTML = groups
      .map(
        (g) =>
          `<div class="group">${g}</div>` +
          E.filter((e) => e.group === g)
            .map(
              (e) =>
                `<div class="effect" style="--c:${e.c}"><input type="checkbox" id="fx-${e.id}" ${has(e.id) ? 'checked' : ''}><div><label for="fx-${e.id}">${e.name}</label><small>${e.desc.split('.')[0]}.</small></div></div>`
            )
            .join('')
      )
      .join('')
    E.forEach((e) => {
      const box = $('fx-' + e.id) as HTMLInputElement
      box.onchange = () => {
        box.checked ? on.add(e.id) : on.delete(e.id)
        render()
      }
    })
  }

  function simulate() {
    const s = ($('scenario') as HTMLSelectElement).value
    const t: string[] = []
    const put = (x: string, c = '') => t.push(`<span class="${c}">${x}</span>`)
    if (has('tracing')) put('start span')
    if (has('logging')) put('log · request started')
    if (has('auth')) put('authorize')
    if (s === 'declined') {
      put('payment · card declined', 'bad')
      if (has('retry')) put('no retry · permanent failure', 'bad')
    } else if (s === 'transient') {
      if (has('retry')) {
        put('payment · attempt 1', 'bad')
        put('backoff 200ms')
        put('payment · attempt 2', 'good')
        put('reserve stock · success', 'good')
      } else put('payment · provider unavailable', 'bad')
    } else if (s === 'db') {
      put('payment · success', 'good')
      if (has('connection')) put('acquire DB connection')
      if (has('transaction')) put('begin transaction')
      put('reserve stock · connection lost', 'bad')
      if (has('transaction')) put('rollback', 'bad')
      if (has('connection')) put('release connection')
    } else {
      put('payment · success', 'good')
      put('reserve stock · success', 'good')
      put('save order · success', 'good')
    }
    if (has('metrics')) put('record latency + outcome')
    if (has('logging')) put('log · request finished')
    if (has('tracing')) put('end span')
    if (s === 'ok' || (s === 'transient' && has('retry')))
      put('return receipt', 'good')
    else put(has('failure') ? 'return Err(error)' : 'failure escapes', 'bad')
    $('trace').innerHTML = t.join('')
  }

  paint(
    $('core'),
    core.map((s) => [s])
  )
  controls()
  render()
  $('all').onclick = () => {
    on = new Set(E.map((e) => e.id))
    controls()
    render()
  }
  $('clear').onclick = () => {
    on.clear()
    controls()
    render()
  }
  document.querySelectorAll<HTMLElement>('.tab').forEach(
    (b) =>
      (b.onclick = () => {
        view = b.dataset.view!
        render()
      })
  )
  $('scenario').onchange = simulate
</script>
