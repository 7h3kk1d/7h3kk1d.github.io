---
import BaseLayout from '../../layouts/BaseLayout.astro'

// Most projects are their own repo deployed to GitHub Pages, which serves them
// under this domain at /<repo name>/. Ones without a `repo` are pages here.
const projects: {
  title: string
  description: string
  url: string
  repo?: string
  /** A blog post the project goes with. */
  post?: string
  /** Built mostly by an AI coding agent: shown as 🤖 with hover text. */
  vibecoded?: boolean
}[] = [
  {
    title: 'Compositional Window Management',
    description:
      'nest windows inside tabs, splits, canvases, kanban boards and timelines, and switch any container between views without losing its layout',
    url: '/compositional-window-management/',
    repo: 'https://github.com/7h3kk1d/compositional-window-management',
    post: '/on-compositional-window-management/',
    vibecoded: true,
  },
  {
    title: 'Cross-Cutting Concerns',
    description:
      'toggle concerns like retries, transactions and logging on an order function and see them woven in',
    url: '/projects/computational-effects/',
    vibecoded: true,
  },
  {
    title: 'Bidirectional JSON Editor',
    description:
      'text and tree views of a JSON document, kept in sync incrementally in both directions',
    url: '/bidirectional-json-editor/',
    repo: 'https://github.com/7h3kk1d/bidirectional-json-editor',
    vibecoded: true,
  },
  {
    title: 'JSON Editor',
    description: 'a structure editor for JSON',
    url: '/json-editor/',
    repo: 'https://github.com/7h3kk1d/json-editor',
  },
]
---

<BaseLayout
  title="Projects"
  description="Projects by Alexander Bandukwala that you can try in the browser."
>
  <div>
    <h1>Projects</h1>
    <ul>
      {
        projects.map((project) => (
          <li>
            <a href={project.url}>{project.title}</a>, {project.description}
            {project.vibecoded && (
              <span>
                {' '}
                <span
                  class="vibecoded"
                  role="img"
                  aria-label="Vibecoded"
                  title="Vibecoded: built mostly by an AI coding agent"
                >
                  🤖
                </span>
              </span>
            )}
            {project.post && (
              <span>
                {' '}
                (<a href={project.post}>blog post</a>)
              </span>
            )}
            {project.repo && (
              <span>
                {' '}
                (<a href={project.repo}>source</a>)
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .vibecoded {
    cursor: help;
  }
</style>
