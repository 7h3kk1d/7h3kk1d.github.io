---
import { formatIsoDate } from '../lib/dates'
import { tagUrl, type Post } from '../lib/posts'

interface Props {
  posts: Post[]
}

const { posts } = Astro.props
---

{
  posts.map((post) => (
    <div>
      <a href={`/${post.id}/`} style="text-decoration: none; color: inherit;">
        <h3 style="text-decoration: none; margin-bottom: 0.1975rem; margin-top: 1.975rem;">
          {post.data.title}
          <span style="color: lightgray;">
            - {formatIsoDate(post.data.date)}
          </span>
        </h3>
        <p>{post.data.description}</p>
      </a>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="tags" style="margin-top: -0.79rem;">
          {post.data.tags.map((tag) => (
            <a href={tagUrl(tag)} class="tag">
              {tag}
            </a>
          ))}
        </div>
      )}
    </div>
  ))
}
