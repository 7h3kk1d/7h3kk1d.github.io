---
import '../styles/typography.css'
import '../styles/global.css'
import '../styles/blog.css'
import SocialDropdown from '../components/SocialDropdown.astro'
import ThemeToggle from '../components/theme-toggle'
import Search from '../components/search'
import { getCollection } from 'astro:content'

interface Props {
  title?: string
}

const { title } = Astro.props
const siteTitle = 'Alexander Bandukwala'
const siteDescription = "Alexander Bandukwala's personal website"
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle

const allPosts = await getCollection('blog')
const searchPosts = allPosts
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  )
  .map((post) => ({
    title: post.data.title,
    date: new Date(post.data.date).toLocaleDateString('en-CA'),
    tags: post.data.tags || [],
    slug: `/${post.id}/`,
    excerpt: post.data.description,
  }))
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={siteDescription} />
    <meta name="keywords" content="blog, programming" />
    <title>{pageTitle}</title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteTitle}
      href="/rss.xml"
    />
    <script is:inline>
      ;(function () {
        function getInitialTheme() {
          const persistedTheme = window.localStorage.getItem('theme')
          const hasPersistedTheme = typeof persistedTheme === 'string'

          if (hasPersistedTheme) {
            return persistedTheme
          }

          const systemPrefersDark = window.matchMedia(
            '(prefers-color-scheme: dark)'
          ).matches
          return systemPrefersDark ? 'dark' : 'light'
        }

        const theme = getInitialTheme()
        document.documentElement.setAttribute('data-theme', theme)
      })()
    </script>
  </head>
  <body>
    <div style="margin: 0 auto; max-width: 960px; padding: 1.25rem 1rem;">
      <header style="margin-bottom: 1.58rem; width: 100%;">
        <div>
          <a href="/" style="text-shadow: none; background-image: none;">
            <h3 style="display: inline;">{siteTitle}</h3>
          </a>
          <ul
            style="list-style: none; float: right; display: flex; align-items: center; margin: 0;"
          >
            <li style="display: inline-block; margin-right: 1rem;">
              <a href="/">Home</a>
            </li>
            <li style="display: inline-block; margin-right: 1rem;">
              <a href="/about">About</a>
            </li>
            <li style="display: inline-block; margin-right: 1rem;">
              <a href="/tags">Tags</a>
            </li>
            <li style="display: inline-block; margin-right: 1rem;">
              <a href="/cv">CV</a>
            </li>
            <SocialDropdown />
            <Search client:load posts={searchPosts} />
            <li style="display: inline-block; margin-left: 1rem;">
              <ThemeToggle client:load />
            </li>
          </ul>
        </div>
      </header>
      <slot />
    </div>
  </body>
</html>
